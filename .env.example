# Copy to .env (gitignored). The CLI and evals load it automatically (python-dotenv);
# or: set -a; source .env; set +a

# ---- Model (Benchpress is model-agnostic; any OpenAI-compatible chat-completions endpoint) ----
# platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=
# default candidate + baseline model
BENCHPRESS_MODEL=deepseek-v4-pro
# cheap fast model for iterating on prompts
BENCHPRESS_DEV_MODEL=deepseek-flash
# OpenAI-compatible base URL
BENCHPRESS_API_BASE=https://api.deepseek.com/v1
# optional override; falls back to DEEPSEEK_API_KEY / OPENAI_API_KEY
BENCHPRESS_API_KEY=
# optional: enables claude-* models via the Messages API
ANTHROPIC_API_KEY=

# ---- Arga (only with multi-twin access; Free = 1 twin/run cannot run ArgaBench tasks) ----
ARGA_API_URL=https://api.argalabs.com
ARGA_API_KEY=

# ---- Real-app mode: scratch/test accounts ONLY. The gateway refuses non-test Stripe keys. ----
# set to 1 to allow seeding/resetting the scratch accounts below
BENCHPRESS_SCRATCH_OK=
# xoxb-… scopes: chat:write chat:write.customize chat:write.public channels:read channels:history channels:manage channels:join groups:read users:read
SLACK_BOT_TOKEN=
# sk_test_… TEST MODE ONLY
STRIPE_SECRET_KEY=
# pat-… scopes: crm.objects.{companies,contacts,deals}.read/write crm.schemas.{companies,contacts}.read
HUBSPOT_PRIVATE_APP_TOKEN=
# GCP OAuth Desktop client
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# from OAuth Playground with scope https://mail.google.com/
GMAIL_REFRESH_TOKEN=
# the scratch Gmail address (seeded mail is re-addressed to it)
GMAIL_ADDRESS=
# optional short-lived alternative to the refresh flow
GMAIL_ACCESS_TOKEN=
# stretch: scratch repo for the CI-quarantine scenario
GITHUB_TOKEN=
# stretch
LINEAR_API_KEY=

# ---- devsim (local twins). Set by `python -m devsim serve`; override to point the real-app gateway at a twin ----
DEVSIM_SLACK_URL=
DEVSIM_GMAIL_URL=
DEVSIM_HUBSPOT_URL=
DEVSIM_STRIPE_URL=

# ---- Optional tracing ----
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# ---- Benchpress knobs ----
# comma list: no_policy_sweep,no_gate,no_readback
BENCHPRESS_ABLATIONS=
