# Copy to .env (gitignored). Load with: set -a; source .env; set +a

# Required
ANTHROPIC_API_KEY=

# Plan A only (multi-twin Arga access)
ARGA_API_URL=https://api.argalabs.com
ARGA_API_KEY=

# Real-app mode (usefulness segment). Scratch/test accounts only, never production data.
SLACK_BOT_TOKEN=            # xoxb-… scopes: chat:write channels:read channels:history groups:read users:read
STRIPE_SECRET_KEY=          # sk_test_… TEST MODE ONLY
HUBSPOT_PRIVATE_APP_TOKEN=  # pat-… scopes: crm.objects.companies.read/write crm.objects.contacts.read/write
GMAIL_ACCESS_TOKEN=         # optional; scopes gmail.compose gmail.readonly

# Optional tracing
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# Benchpress
BENCHPRESS_MODEL=claude-opus-5
BENCHPRESS_EFFORT=high
BENCHPRESS_DEV_MODEL=claude-sonnet-5
