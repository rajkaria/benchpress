# Copy to .env (gitignored). The CLI and evals load it automatically (python-dotenv);
# or: set -a; source .env; set +a

# ---- Model (Benchpress is model-agnostic; any OpenAI-compatible chat-completions endpoint) ----
DEEPSEEK_API_KEY=                 # platform.deepseek.com -> API keys
BENCHPRESS_MODEL=deepseek-chat    # default candidate + baseline model
BENCHPRESS_API_BASE=https://api.deepseek.com   # OpenAI-compatible base URL
BENCHPRESS_API_KEY=               # optional override; falls back to DEEPSEEK_API_KEY / OPENAI_API_KEY
ANTHROPIC_API_KEY=                # optional: enables claude-* models via the Messages API

# ---- Arga (only with multi-twin access; Free = 1 twin/run cannot run ArgaBench tasks) ----
ARGA_API_URL=https://api.argalabs.com
ARGA_API_KEY=

# ---- Real-app mode: scratch/test accounts ONLY. The gateway refuses non-test Stripe keys. ----
BENCHPRESS_SCRATCH_OK=            # set to 1 to allow seeding/resetting the scratch accounts below
SLACK_BOT_TOKEN=                  # xoxb-… scopes: chat:write chat:write.customize chat:write.public channels:read channels:history channels:manage channels:join groups:read users:read
STRIPE_SECRET_KEY=                # sk_test_… TEST MODE ONLY
HUBSPOT_PRIVATE_APP_TOKEN=        # pat-… scopes: crm.objects.{companies,contacts,deals}.read/write crm.schemas.{companies,contacts}.read
GMAIL_CLIENT_ID=                  # GCP OAuth Desktop client
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=              # from OAuth Playground with scope https://mail.google.com/
GMAIL_ACCESS_TOKEN=               # optional short-lived alternative to the refresh flow
GITHUB_TOKEN=                     # stretch: scratch repo for the CI-quarantine scenario
LINEAR_API_KEY=                   # stretch

# ---- devsim (local twins). Set by `python -m devsim serve`; override to point the real-app gateway at a twin ----
DEVSIM_SLACK_URL=
DEVSIM_GMAIL_URL=
DEVSIM_HUBSPOT_URL=
DEVSIM_STRIPE_URL=

# ---- Optional tracing ----
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# ---- Benchpress knobs ----
BENCHPRESS_ABLATIONS=             # comma list: no_policy_sweep,no_gate,no_readback
